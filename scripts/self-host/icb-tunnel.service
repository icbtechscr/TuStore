[Unit]
Description=ICB Cloudflare Tunnel (activate only after origin checks)
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/etc/icb/cloudflare.token

[Service]
Type=simple
UMask=0077
ExecStart=/usr/bin/docker run --rm --name icb-tunnel --network host --cap-drop ALL --security-opt no-new-privileges --read-only --user 65532:65532 --memory 192m --mount type=bind,source=/etc/icb/cloudflare.token,target=/run/secrets/tunnel,readonly cloudflare/cloudflared@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38 tunnel --no-autoupdate --protocol http2 run --token-file /run/secrets/tunnel
ExecStop=/usr/bin/docker stop --time 20 icb-tunnel
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
