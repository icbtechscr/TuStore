# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cybersource / Unified Checkout (BAC Costa Rica)
# apitest = sandbox, api = producción
CYBS_RUN_ENV=apitest
CYBS_MERCHANT_ID=
CYBS_KEY_ID=
CYBS_SECRET_KEY=

# Tilopay Checkout (las credenciales se cargan como secretos en Coolify)
TILOPAY_APIUSER=
TILOPAY_PASSWORD=
TILOPAY_KEY=

# Origen del sitio (para CORS / target origin del iframe UC)
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# URL pública canónica usada por SEO, sitemap y datos estructurados
NEXT_PUBLIC_SITE_URL=https://tustorecr.com
# Opcional durante la transición. Vacío = no consultar WordPress.
TUSTORE_STORE_API_URL=
# Hosts/orígenes antiguos solo mientras se migran imágenes; separados por coma.
NEXT_PUBLIC_TUSTORE_LEGACY_MEDIA_HOSTS=
NEXT_PUBLIC_TUSTORE_PREVIOUS_STORAGE_ORIGINS=
# Host temporal del WordPress anterior (se elimina al completar la migración).
NEXT_PUBLIC_TUSTORE_LEGACY_MEDIA_ORIGIN=https://mail.tustorecr.com

# Facebook / Meta (panel de vendedores — publicar productos en Páginas)
# Crear app en https://developers.facebook.com → Configuración → Básica.
# El callback OAuth es: {SITE_ORIGIN}/api/vendor/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Chatbot IA (Groq) — asistente virtual de la tienda
# Crear la llave en https://console.groq.com/keys
GROQ_API_KEY=
# Modelo de chat (opcional). Por defecto: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Respaldo del chatbot (opcional): Gemini Flash. Si Groq falla por límite,
# el bot usa Gemini automáticamente. La key empieza con "AIza..."
# Generala gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Módulos futuros de TuStore (no requeridos para la tienda actual) ---
# CPI (appcontadorcpi.com) — sincronización de ventas por vendedor.
# Login de empresa dedicado a la integración (ver /api/admin/sales/sync).
CPI_BASE_URL=https://www.appcontadorcpi.com/gm/
CPI_USER=
CPI_PASS=
CPI_ID=
# Proxy con IP de Costa Rica (CPI bloquea IPs de datacenter como las de Vercel).
# Formato: http://usuario:clave@host:puerto
CPI_PROXY=
# Secreto para el cron horario (Vercel Cron: Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET ya se usa para el recordatorio de marcaje.

# --- Agente de WhatsApp (worker Baileys local) ---
# Secreto aleatorio compartido por Vercel y la PC del worker.
AGENT_WORKER_SECRET=
# URL de la web a la que el worker envia los mensajes entrantes.
AGENT_API_URL=https://tustorecr.com

# Mantiene deshabilitados correos, cobros y notificaciones hasta autorizar el corte.
TUSTORE_EXTERNAL_EFFECTS_ENABLED=false
